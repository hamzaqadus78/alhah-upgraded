DATABASE_URL=postgresql://user:password@host:5432/dbname
# Comma-separated list is fine — needed so local dev and the deployed site
# can both reach this API at once.
CORS_ALLOWED_ORIGIN=https://alhahindustries.com
FRONTEND_BASE=https://alhahindustries.com
PORT=3000

# Contact form email (server/src/services/email.service.js) — sent via Gmail SMTP.
# GMAIL_USER: the Gmail address that sends the mail (e.g. alhahindustries@gmail.com)
# GMAIL_APP_PASSWORD: a 16-character App Password, NOT the account password —
#   generate one at https://myaccount.google.com/apppasswords (requires 2FA enabled).
# CONTACT_RECEIVER_EMAIL: where contact form messages land (defaults to GMAIL_USER).
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_RECEIVER_EMAIL=alhahindustries@gmail.com

# Customer login and Admin dashboard sessions — separate secrets so a user
# session can never be mistaken for an admin session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
USER_JWT_SECRET=
ADMIN_JWT_SECRET=

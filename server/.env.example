DATABASE_URL=postgresql://user:password@host:5432/dbname
# Comma-separated list is fine — needed so local dev and the deployed site
# can both reach this API at once.
CORS_ALLOWED_ORIGIN=https://alhahindustries.com
FRONTEND_BASE=https://alhahindustries.com
PORT=3000

# Email (server/src/services/email.service.js) — sent via Brevo's HTTP API,
# not SMTP. Render's free tier permanently blocks outbound SMTP ports, so
# nodemailer/Gmail SMTP times out from there; Brevo sends over normal HTTPS.
# BREVO_API_KEY: from Brevo dashboard > Email > Transactional > API Keys.
# EMAIL_SENDER: must be a sender address verified in Brevo (Settings >
#   Senders — just a confirmation-link click, no domain ownership needed).
# CONTACT_RECEIVER_EMAIL: where contact form + order emails land (defaults
#   to EMAIL_SENDER).
BREVO_API_KEY=
EMAIL_SENDER=
CONTACT_RECEIVER_EMAIL=alhahindustries@gmail.com

# Customer login and Admin dashboard sessions — separate secrets so a user
# session can never be mistaken for an admin session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
USER_JWT_SECRET=
ADMIN_JWT_SECRET=

# Signs email verification links (signup confirm, checkout confirm) —
# separate from the two session secrets above. Generate the same way.
EMAIL_VERIFY_SECRET=
